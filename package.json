{
  "name": "steril-track-next-prisma",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "setup": "tsx scripts/setup.ts",
    "db:baseline": "tsx scripts/baseline-v2.ts",
    "backup": "tsx scripts/backup.ts",
    "test": "tsx tests/calendar.ts && tsx tests/seed.ts && tsx tests/upgrade.ts && tsx tests/integration.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.3",
    "dotenv": "17.2.3",
    "lucide-react": "1.31.0",
    "next": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  }
}
